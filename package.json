{
  "displayName": "TuyaWebPlatform",
  "name": "@homebridge-plugins/homebridge-tuya-web",
  "version": "1.1.5",
  "description": "Homebridge plugin for use with Tuya devices (uses Home Assistant Tuya Web API)",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "changelog:sync": "node .github/scripts/sync-changelog.mjs",
    "lint": "eslint .",
    "prepublishOnly": "npm run lint && npm run build",
    "prettier": "prettier --check .",
    "test": "echo \"No tests yet\" && exit 0",
    "watch": "npm run build && npm link && nodemon",
    "clear-cache": "rimraf ~/.homebridge/accessories/cachedAccessories && rimraf ~/.homebridge/persist/*"
  },
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "supports-hap",
    "tuya",
    "smartlife",
    "tuyawebplatform",
    "tuyaweb"
  ],
  "author": "Milo Cesar <milocesar1@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.11.4 || ^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/homebridge-plugins/homebridge-tuya-web.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge-plugins/homebridge-tuya-web/issues"
  },
  "homepage": "https://github.com/homebridge-plugins/homebridge-tuya-web#readme",
  "dependencies": {
    "axios": "^1.19.0",
    "lodash.debounce": "^4.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "homebridge": "^2.2.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
